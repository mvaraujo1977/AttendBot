# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Identidade do bot -------------------------------------------------------
NOME_EMPRESA="Loja Exemplo"
MENSAGEM_TRANSBORDO="Não encontrei essa informação por aqui, mas já estou encaminhando você para um de nossos atendentes."
# Resposta fixa de /start, /help e /ajuda. Vazio usa o texto padrão do código.
MENSAGEM_BOAS_VINDAS=

# --- RAG ---------------------------------------------------------------------
# Primeira das duas barreiras de transbordo: similaridade mínima (0 a 1) para
# o contexto sequer chegar ao LLM. Fica baixo de propósito — é um filtro
# barato, não o juiz. Quem decide os casos de fronteira é a segunda barreira,
# no próprio LLM. Ver a seção de calibração no README.
# Calibrado para o MODELO_EMBEDDING abaixo: trocar de modelo exige recalibrar.
LIMIAR_SIMILARIDADE=0.80
TOP_K=3
COLECAO_CHROMA=faq
# Modelo local de embeddings (roda offline, sem custo de API).
# Alternativa mais leve (~470 MB em vez de ~2,2 GB), mas com retrieval bem pior
# em português acentuado (6/10 contra 10/10 na medição do README):
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELO_EMBEDDING=intfloat/multilingual-e5-large

# --- LLM ---------------------------------------------------------------------
# openai = usa a API da OpenAI | demo = responde sem API (útil para testar)
PROVEDOR_LLM=openai
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
OPENAI_TEMPERATURA=0.3

# --- Canal de mensageria -----------------------------------------------------
# twilio   = WhatsApp. Enviar funciona no trial, mas CONFIGURAR O WEBHOOK exige
#            conta paga: a tela de Sandbox settings redireciona para o upgrade.
# telegram = canal gratuito de ponta a ponta. É o usado na demonstração.
CANAL=telegram

# --- Telegram ----------------------------------------------------------------
# Token do bot criado no @BotFather (formato 123456789:AA...).
TELEGRAM_BOT_TOKEN=
# Com TELEGRAM_DRY_RUN=true nada é enviado: a resposta só aparece no log.
TELEGRAM_DRY_RUN=true
# Segredo passado no setWebhook e conferido em todo update. Vazio = webhook
# aberto; só deixe vazio em teste local.
TELEGRAM_SEGREDO_WEBHOOK=

# --- WhatsApp / Twilio Sandbox -----------------------------------------------
# Com TWILIO_DRY_RUN=true nada é enviado: a resposta só aparece no log.
# Deixe true enquanto não tiver credenciais.
TWILIO_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do Sandbox atribuído à SUA conta (console do Twilio > Messaging >
# Try it out > WhatsApp). É o mesmo para onde você mandou o "join <código>".
# Varia por conta: o +14155238886 é o do sandbox antigo e não serve de padrão.
TWILIO_NUMERO_ORIGEM=whatsapp:+15550000000

# Validação da assinatura do webhook (ative ao expor a URL publicamente).
# URL_PUBLICA deve ser exatamente a URL configurada no console do Twilio.
TWILIO_VALIDAR_ASSINATURA=false
URL_PUBLICA=
