# Copie para .env e preencha. O .env nunca vai para o Git.
#
# Duas configurações típicas, descritas no README:
#   LOCAL      PROVEDOR_EMBEDDING=local  + PROVEDOR_LLM=demo|openai
#   PRODUÇÃO   PROVEDOR_EMBEDDING=gemini + PROVEDOR_LLM=gemini

# --- Identidade do bot -------------------------------------------------------
NOME_EMPRESA="Loja Exemplo"
MENSAGEM_TRANSBORDO="Não encontrei essa informação por aqui, mas já estou encaminhando você para um de nossos atendentes."
# Resposta fixa de /start, /help e /ajuda. Vazio usa o texto padrão do código.
MENSAGEM_BOAS_VINDAS=

# --- Embeddings --------------------------------------------------------------
# local  = modelo offline via sentence-transformers. Melhor retrieval e sem
#          custo de API, mas exige `pip install -r requirements-local.txt`
#          (torch, ~2,5 GB) — não cabe nos 512 MB do plano Free do Render.
# gemini = embedding via API. É o de produção. Exige GEMINI_API_KEY.
PROVEDOR_EMBEDDING=local

# Modelo do provedor LOCAL. Alternativa mais leve (~470 MB em vez de ~2,2 GB),
# mas com retrieval bem pior em português acentuado (6/10 contra 10/10 na
# medição do README):
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELO_EMBEDDING=intfloat/multilingual-e5-large

# Modelo e dimensões do provedor GEMINI (Matryoshka: 3072, 1536 ou 768).
GEMINI_MODELO_EMBEDDING=gemini-embedding-001
GEMINI_DIMENSOES_EMBEDDING=768

# --- Contenção de abuso ------------------------------------------------------
# Mensagens que um mesmo remetente pode gastar por minuto (0 desliga). Cada
# mensagem custa duas chamadas de API — embedding da consulta e geração —, e a
# cota do tier gratuito é a mesma para todos os clientes: sem teto, uma
# conversa em volume derruba o atendimento de todo mundo.
LIMITE_MENSAGENS_POR_MINUTO=20

# Corte da pergunta antes de ela virar embedding e prompt. O custo em tokens é
# linear no tamanho, e o Telegram já aceita 4096 caracteres.
LIMITE_CARACTERES_PERGUNTA=1000

# --- RAG ---------------------------------------------------------------------
# Primeira das duas barreiras de transbordo: similaridade mínima (0 a 1) para
# o contexto sequer chegar ao LLM. Fica baixo de propósito — é um filtro
# barato, não o juiz. Quem decide os casos de fronteira é a segunda barreira,
# no próprio LLM. Ver a seção de calibração no README.
#
# VAZIO usa o limiar calibrado do PROVEDOR_EMBEDDING ativo, que é o padrão
# recomendado: limiar e modelo de embedding são uma coisa só. Medidos até aqui:
#   local (multilingual-e5-large)  -> 0.80
#   gemini (gemini-embedding-001)  -> 0.77
# Só fixe um valor aqui depois de medir com `python -m scripts.calibrar_limiar`.
LIMIAR_SIMILARIDADE=
TOP_K=3
COLECAO_CHROMA=faq

# --- LLM ---------------------------------------------------------------------
# openai = API da OpenAI | gemini = API do Gemini (tier gratuito)
# demo   = responde sem API nenhuma, útil para testar offline
PROVEDOR_LLM=demo

OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
OPENAI_TEMPERATURA=0.3

# Uma chave só serve para o LLM e para o embedding do Gemini.
# Pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confira com `GET /v1beta/models` E uma chamada real: o gemini-2.5-flash ainda
# aparece na listagem, mas o generateContent o recusa com 404 para chaves novas.
GEMINI_MODELO=gemini-3.5-flash-lite
GEMINI_TEMPERATURA=0.3
# Vazio omite o campo — que é o que o modelo padrão exige. Só preencha (0
# desliga o raciocínio e corta latência) em modelos que aceitam: os 3.5+
# recusam com 400, o 3.1-flash-lite e o 2.5 aceitam.
GEMINI_ORCAMENTO_RACIOCINIO=

# --- Deploy ------------------------------------------------------------------
# Reconstrói o índice na subida da aplicação. Obrigatório no Render, cujo
# filesystem é efêmero. Localmente é um no-op depois da primeira vez: a
# ingestão só roda se o índice não refletir o faq_dataset.json.
REINDEXAR_NO_STARTUP=true

# Liga o `/api/mensagem` e a documentação interativa (`/docs`, `/redoc`,
# `/openapi.json`). Útil localmente, perigoso em produção: o `/api/mensagem`
# roda o RAG sem passar por assinatura, segredo de webhook ou deduplicação —
# é o caminho mais barato para alguém queimar a cota do LLM — e o
# `/openapi.json` publica o mapa das rotas. Deixe `false` ao expor a URL.
EXPOR_FERRAMENTAS_DE_TESTE=true

# --- Canal de mensageria -----------------------------------------------------
# twilio   = WhatsApp. Enviar funciona no trial, mas CONFIGURAR O WEBHOOK exige
#            conta paga: a tela de Sandbox settings redireciona para o upgrade.
# telegram = canal gratuito de ponta a ponta. É o usado na demonstração.
CANAL=telegram

# --- Telegram ----------------------------------------------------------------
# Token do bot criado no @BotFather (formato 123456789:AA...).
TELEGRAM_BOT_TOKEN=
# Com TELEGRAM_DRY_RUN=true nada é enviado: a resposta só aparece no log.
TELEGRAM_DRY_RUN=true
# Segredo passado no setWebhook e conferido em todo update. Vazio = webhook
# aberto, então com TELEGRAM_DRY_RUN=false ele é OBRIGATÓRIO: a app recusa
# subir sem ele, em vez de servir uma rota que qualquer um pode chamar.
TELEGRAM_SEGREDO_WEBHOOK=

# --- WhatsApp / Twilio Sandbox -----------------------------------------------
# Com TWILIO_DRY_RUN=true nada é enviado: a resposta só aparece no log.
# Deixe true enquanto não tiver credenciais.
TWILIO_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do Sandbox atribuído à SUA conta (console do Twilio > Messaging >
# Try it out > WhatsApp). É o mesmo para onde você mandou o "join <código>".
# Varia por conta: o +14155238886 é o do sandbox antigo e não serve de padrão.
TWILIO_NUMERO_ORIGEM=whatsapp:+15550000000

# Validação da assinatura do webhook. Com TWILIO_DRY_RUN=false ela é
# OBRIGATÓRIA: a app recusa subir sem ela. URL_PUBLICA precisa ser exatamente
# a URL configurada no console do Twilio — a assinatura é calculada sobre ela,
# e atrás de um proxy a URL que o app enxerga costuma vir como http://.
TWILIO_VALIDAR_ASSINATURA=false
URL_PUBLICA=
